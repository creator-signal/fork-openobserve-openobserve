{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creatorsignal.com/schemas/openobserve-oidc-release-metadata.schema.json",
  "title": "Creator Signal OpenObserve OIDC release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "upstreamRef",
    "upstreamVersion",
    "upstreamCommit",
    "sourceRepository",
    "sourceCommit",
    "sourceTag",
    "image",
    "imageDigest",
    "features",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "upstreamRef": { "const": "main" },
    "upstreamVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "upstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceRepository": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceTag": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "pattern": "^ghcr\\.io/" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "oidc" }
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
